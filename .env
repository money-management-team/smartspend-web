# Safe local defaults. This file is tracked, so it must never name a real server.
# The dev server forwards /api to http://127.0.0.1:8000 unless you configure it
# otherwise (see docs/dev-environment/local-api-target.md and .env.example).
# Production is built by .github/workflows/deploy-hostinger.yml, which supplies
# its own VITE_API_BASE_URL and validates it; nothing here reaches that build.
VITE_API_BASE_URL=/api
VITE_GOOGLE_CLIENT_ID=
