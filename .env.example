# Copy to .env.local (git-ignored) for private settings.
#
# Local development is fail-closed: with no configuration the Vite dev server
# forwards /api to the local Laravel at http://127.0.0.1:8000. Nothing contacts
# staging or production unless you ask for it explicitly, twice:
#
#   SMARTSPEND_DEV_API_ORIGIN=https://some-remote-api.example   # what to proxy to
#   SMARTSPEND_ALLOW_REMOTE_API=true                            # confirm it is remote on purpose
#
# Production is built by .github/workflows/deploy-hostinger.yml, which requires
# VITE_API_BASE_URL=https://smartspend-api.anasalharazeen.com/api.
VITE_API_BASE_URL=/api
VITE_GOOGLE_CLIENT_ID=

# Smart Savings (unreleased, OFF by default). Exactly "true" or "false".
# Set it in .env.local only, never in .env or .env.[mode]: the build
# refuses committable files that set it. `npm run dev` with it on needs
# nothing else. A production build (`npm run build`) with it on also needs
# SMARTSPEND_SMART_SAVINGS_RELEASE_APPROVED=true in the shell, which only
# an approved release sets; the Hostinger workflow pins it off.
# See docs/savings-goals/smart-plans.md ("Release gate").
# VITE_SMART_SAVINGS_ENABLED=true
